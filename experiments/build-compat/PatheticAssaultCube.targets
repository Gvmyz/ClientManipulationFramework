<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Reuse upstream Debug settings in Release without editing the clone. -->
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'AssaultCube-Internal'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)Dependencies\minhook\include;$(ProjectDir)Dependencies\ImGui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
